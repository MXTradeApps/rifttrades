{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/leader-readonly.js",
        "matcher": "Write|Delete",
        "timeout": 10
      }
    ],
    "subagentStart": [
      {
        "command": "node .cursor/hooks/leader-readonly.js",
        "timeout": 10
      }
    ]
  }
}
